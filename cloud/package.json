{
  "name": "cloud-opencode-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud backend for SikoroApps Cloud OpenCode: sessions, persistent chat history and AI model fallback.",
  "scripts": {
    "start": "node src/index.ts",
    "test": "node --test tests/*.test.ts",
    "check:config": "node --experimental-strip-types --no-warnings scripts/check-config.mjs",
    "check:deployment": "node --experimental-strip-types --no-warnings scripts/check-deployment.mjs",
    "check:deploy-files": "node scripts/check-deploy-files.mjs",
    "check:release": "node --experimental-strip-types --no-warnings scripts/check-release-readiness.mjs",
    "generate:key": "node scripts/generate-encryption-key.mjs",
    "verify:ai": "node --experimental-strip-types --no-warnings scripts/verify-ai.mjs",
    "typecheck": "node --experimental-strip-types --no-warnings --check src/server.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Proprietary"
}
