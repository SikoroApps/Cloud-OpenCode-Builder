# Copy to deploy/.env on the host and fill in values there. Never commit deploy/.env.
# Domain must have A/AAAA records pointing at this host; Caddy obtains HTTPS automatically.
CLOUD_DOMAIN=example.com
BACKEND_IMAGE=ghcr.io/sikoroapps/cloud-opencode-backend:latest

# Backend configuration (see docs/DEPLOYMENT.md and docs/GITHUB_OAUTH_SETUP.md)
CLOUD_BASE_URL=https://example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://example.com/api/github/oauth/callback
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_APP_CALLBACK_URL=cloudopencode://github/callback
OPENCODE_API_KEY=
OPENROUTER_API_KEY=

# In-memory rate limits are enabled by default. TRUST_PROXY=1 is correct only when
# Caddy is the sole public entry point and clients cannot reach the backend directly.
RATE_LIMIT_ENABLED=1
TRUST_PROXY=1
